# Copy to backend/.env and fill in. Never commit the real .env.

MONGO_URI=
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ── Verification & password-reset email ──
# Preferred: Resend HTTPS API (works on hosts that block outbound SMTP ports).
# Create a key at resend.com/api-keys. EMAIL_FROM must use a domain verified at
# resend.com/domains; the test sender onboarding@resend.dev only delivers to your
# own Resend account address.
RESEND_API_KEY=
EMAIL_FROM="Critica Bureau <no-reply@your-verified-domain.com>"

# Fallback, used only when RESEND_API_KEY is empty: Gmail SMTP.
# EMAIL_SERVER_PASSWORD must be a Gmail *App Password* (Google Account →
# Security → 2-Step Verification → App passwords), not your normal password.
# With SMTP, EMAIL_FROM must be the Gmail address itself.
# Leave both RESEND_API_KEY and USER/PASSWORD empty in development to print codes to the console.
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=

# Public frontend URL used in email links (set to the production URL when deployed)
FRONTEND_URL=http://localhost:3000
