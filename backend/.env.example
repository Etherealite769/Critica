# Copy to backend/.env and fill in. Never commit the real .env.

MONGO_URI=
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ── Verification email (Gmail SMTP) ──
# EMAIL_SERVER_PASSWORD must be a Gmail *App Password* (Google Account →
# Security → 2-Step Verification → App passwords), not your normal password.
# Leave USER/PASSWORD empty in development to print codes to the console instead.
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM="Critica Bureau <your-address@gmail.com>"

# Frontend base URL for the one-click verification link
FRONTEND_URL=http://localhost:3000
